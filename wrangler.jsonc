{
  // ゲーム用のWorker(今の「artifact学会。」とは別物)
  "name": "artifactconference-craft",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // site/ フォルダの中身をそのまま配信する。/ws だけ worker/ のプログラムが受ける
  "assets": {
    "directory": "./site"
  },
  // ゲームの「部屋」(全員の位置を預かる)
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
